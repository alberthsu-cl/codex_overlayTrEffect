{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Transition Analysis Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "input_video",
    "video_metadata",
    "transition",
    "visual_signals",
    "frame_progress_mapping",
    "evidence",
    "limitations",
    "planner_hints"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "transition_structure"
    },
    "artifact_version": {
      "type": "integer",
      "const": 1
    },
    "input_video": {
      "type": "string",
      "description": "Local path or logical identifier for the analyzed sample video."
    },
    "video_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_count"
      ],
      "properties": {
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_label",
        "summary",
        "start_frame",
        "end_frame",
        "confidence"
      ],
      "properties": {
        "style_label": {
          "type": "string",
          "description": "Short label for the visible transition family."
        },
        "structure_type": {
          "type": "string",
          "description": "General structural category such as quadrant split, horizontal band split, vertical band split, masked split, dissolve, uv displacement, or other."
        },
        "region_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Approximate number of independently moving regions when the transition is segmented."
        },
        "motion_axes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "High-level motion axes or geometry descriptors such as horizontal, vertical, opposed, or radial."
        },
        "split_geometry": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short description of the split layout, such as 2x2 quadrants or horizontal bands."
        },
        "summary": {
          "type": "string",
          "description": "One-sentence description of the visible source-to-target transformation."
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stable_source_a_end_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stable_source_b_start_frame": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "window_review_status": {
          "type": "string",
          "enum": [
            "verified",
            "needs_review",
            "repaired"
          ],
          "description": "Whether the boundary selection is ready for downstream use or should be revisited."
        },
        "window_review_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "visual_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_dissolve",
        "identity_morph",
        "scene_blend",
        "motion_smoothing",
        "lighting_continuity"
      ],
      "properties": {
          "cross_dissolve": {
            "type": "boolean"
          },
        "identity_morph": {
          "type": "boolean"
        },
        "scene_blend": {
          "type": "boolean"
        },
        "motion_smoothing": {
          "type": "boolean"
        },
        "lighting_continuity": {
          "type": "boolean"
        },
        "camera_continuity": {
          "type": "boolean"
        },
          "masked_blend": {
            "type": "boolean"
          },
          "uv_displacement": {
            "type": "boolean"
          },
          "blur_or_softening": {
            "type": "boolean"
          },
          "rgb_split": {
            "type": "boolean"
          },
          "noise_or_grain": {
            "type": "boolean"
          },
          "warmth_shift": {
            "type": "boolean"
          },
        "bokeh_continuity": {
          "type": "boolean"
        }
      }
    },
    "frame_progress_mapping": {
      "type": "array",
      "description": "Frame-by-frame transition progression mapping in display order across the main transition window.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index",
          "normalized_progress",
          "phase"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "normalized_progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "phase": {
            "type": "string",
            "description": "Human-readable phase label such as pre, blend, morph, distortion, settle, or end."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "motion_topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disabled", "advisory", "hard"],
              "description": "Whether candidate motion topology is irrelevant, diagnostic-only, or a hard acceptance requirement. Use hard only when the visible segmented structure is unambiguous and essential."
            },
            "minimum_region_match_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minimum_direction_match_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_metrics"],
          "properties": {
            "profile": {
              "type": "string",
              "description": "Short generic profile name such as pixel_transition, segmented_motion, or transform."
            },
            "primary_metrics": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "enum": ["mse", "mae", "ssim", "motion_similarity", "peak_mse", "peak_ssim", "foreground_body_rotation_error", "foreground_body_scale_error", "foreground_body_translation_error", "foreground_body_pivot_error", "foreground_body_rotation_direction_agreement", "geometry_similarity"]}
            },
            "guardrail_metrics": {
              "type": "array",
              "items": {"type": "string", "enum": ["mse", "mae", "ssim", "motion_similarity", "peak_mse", "peak_ssim", "foreground_body_rotation_error", "foreground_body_scale_error", "foreground_body_translation_error", "foreground_body_pivot_error", "foreground_body_rotation_direction_agreement", "geometry_similarity"]}
            },
            "advisory_metrics": {
              "type": "array",
              "items": {"type": "string", "enum": ["mse", "mae", "ssim", "motion_similarity", "peak_mse", "peak_ssim", "foreground_body_rotation_error", "foreground_body_scale_error", "foreground_body_translation_error", "foreground_body_pivot_error", "foreground_body_rotation_direction_agreement", "geometry_similarity"]}
            }
          }
        }
      }
    },
    "planner_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_effect_family",
        "family_status",
        "visual_primitives",
        "new_effect_needed",
        "implementation_status"
      ],
      "properties": {
        "recommended_effect_family": {
          "type": "string",
          "description": "Nearest downstream effect family label."
        },
        "family_status": {
          "type": "string",
          "enum": ["known", "unknown"],
          "description": "Whether the family maps to a known catalog or grammar family."
        },
        "visual_primitives": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Observable primitives that guide implementation when the family is unknown."
        },
        "recommended_effect_id": {
          "type": "string",
          "description": "Suggested existing Effect_ID when there is a strong match."
        },
        "new_effect_needed": {
          "type": "boolean"
        },
        "implementation_status": {
          "type": "string",
          "enum": ["supported", "unsupported", "review_required"],
          "description": "Whether the current constrained workflow can support implementation."
        },
        "implementation_notes": {
          "type": "string"
        },
        "fit_rationale": {
          "type": "string",
          "description": "Short explanation of why the recommended family or effect ID fits the visible transition."
        }
      }
    }
  }
}
